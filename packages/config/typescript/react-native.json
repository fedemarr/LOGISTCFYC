{
  "$schema": "https://json.schemastore.org/tsconfig",
  "display": "FYC React Native (Expo)",
  "extends": "./base.json",
  "compilerOptions": {
    "allowJs": true,
    "jsx": "react-jsx",
    "lib": ["DOM", "ESNext"],
    "module": "preserve",
    "moduleDetection": "force",
    "moduleResolution": "bundler",
    "customConditions": ["react-native"],
    "target": "ESNext",
    "skipLibCheck": true
  }
}
