{
  "name": "@lastmile/web",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint --max-warnings 0",
    "typecheck": "next typegen && tsc --noEmit",
    "db:generate": "dotenv -e ../../.env -- drizzle-kit generate",
    "db:migrate": "dotenv -e ../../.env -- tsx src/lib/db/migrate.ts",
    "db:seed": "dotenv -e ../../.env -- tsx src/lib/db/seed/index.ts",
    "db:studio": "dotenv -e ../../.env -- drizzle-kit studio",
    "db:verify": "dotenv -e ../../.env -- tsx src/lib/db/verify.ts",
    "test": "dotenv -e ../../.env -- vitest run"
  },
  "dependencies": {
    "@base-ui/react": "^1.7.0",
    "@lastmile/shared": "workspace:*",
    "@lastmile/state-machine": "workspace:*",
    "@supabase/supabase-js": "^2.112.2",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "drizzle-orm": "^0.45.2",
    "lucide-react": "^1.31.0",
    "next": "15.5.23",
    "pg": "^8.23.0",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "shadcn": "^4.16.2",
    "tailwind-merge": "^3.6.0",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3",
    "@lastmile/config": "workspace:*",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/pg": "^8.21.0",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "dotenv-cli": "^11.0.0",
    "drizzle-kit": "^0.31.10",
    "eslint": "^9",
    "eslint-config-next": "15.5.23",
    "eslint-config-prettier": "^9.1.0",
    "tailwindcss": "^4",
    "tsx": "^4.23.12",
    "typescript": "^5",
    "vitest": "^2.1.9"
  }
}
