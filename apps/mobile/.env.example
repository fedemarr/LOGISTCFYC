# Expo lee `.env` desde la raíz de ESTE paquete (apps/mobile/), no desde
# la raíz del monorepo — copiá los mismos valores que ../../.env.
# Ver docs/DECISIONES.md (FASE 7) para el porqué de cada uno.

EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=
# URL del backend (apps/web) ya deployado — mismo host que usa el panel.
EXPO_PUBLIC_API_URL=
